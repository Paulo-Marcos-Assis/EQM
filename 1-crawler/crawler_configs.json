{
 "ndmais": {
  "min_page": 1,
  "link_finder": {
   "tag": "a",
   "attrs": {
    "class": "title-text"
   },
   "href_excludes": [
    "/video/"
   ]
  },
  "article_selectors": {
   "title": {
    "tag": "h1"
   },
   "subtitle": {
    "tag": "p",
    "attrs": {
     "class": "subtitle"
    }
   },
   "content": {
    "tag": "div",
    "attrs": {
     "class": "entry-content"
    },
    "find_all": [
     "p",
     "h2",
     "h3"
    ]
   },
   "date": [
    {
     "tag": "div",
     "attrs": {
      "class": "publicacao text-uppercase"
     }
    },
    {
     "tag": "time",
     "attrs": {
      "class": "dt-published"
     },
     "attribute": "datetime"
    },
    {
     "tag": "span",
     "attrs": {
      "class": "metadata date"
     }
    }
   ]
  },
  "date_parser": "iso_or_portuguese"
 },
