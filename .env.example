# Crawler de Notícias — variáveis de ambiente (exemplo)

# Fila (RabbitMQ)
SERVICE_NAME=noticias_collector
INPUT_QUEUE=noticias_collector
OUTPUT_QUEUE=noticias_processor
FAIL_QUEUE=
ERROR_QUEUE=noticias_collector_erro

QUEUE_SERVER_ADDRESS=localhost
QUEUE_SERVER_PORT=5672
RABBIT_MQ_USER=admin
RABBIT_MQ_PWD=admin
RABBIT_MQ_HEARTBEAT=3600
PREFETCH_COUNT=1
QUEUE_MANAGER=RabbitMQ

# MongoDB
USERNAME_MONGODB=admin
SENHA_MONGODB=admin
HOST_MONGODB=localhost
PORT_MONGODB=27017
DATABASE_MONGODB=ceos
DATABASE_AUTENTICACAO_MONGODB=admin

# MinIO (object storage)
OBJECT_STORE_MANAGER=minio
OBJECT_STORAGE_TYPE=private
PUBLIC_OBJECT_STORAGE_ADDRESS=localhost
PUBLIC_OBJECT_STORAGE_PORT=9000
PUBLIC_OBJECT_STORAGE_ACCESS_KEY=minioadmin
PUBLIC_OBJECT_STORAGE_SECRET_KEY=minioadmin
PUBLIC_OBJECT_STORAGE_MINIO_SECURE=false
PUBLIC_BUCKET=workflow-hmg
PRIVATE_OBJECT_STORAGE_ADDRESS=localhost
PRIVATE_OBJECT_STORAGE_PORT=9000
PRIVATE_OBJECT_STORAGE_ACCESS_KEY=minioadmin
PRIVATE_OBJECT_STORAGE_SECRET_KEY=minioadmin
PRIVATE_OBJECT_STORAGE_MINIO_SECURE=false

# Observabilidade (opcional)
URL_SENTRY=
VERBOSE=